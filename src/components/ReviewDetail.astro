---
import MahjongTable from './MahjongTable.astro';
import { kyokuLabel, withMe } from '../lib/mahjong';

interface Props {
  data: any;
}
const { data } = Astro.props;
const me = data.myseat;
const m = data.metrics ?? {};
const metrics = [
  { label: '레이팅', value: m.rating },
  { label: '일치율', value: m.match },
  { label: '악수율', value: m.bad, warn: true },
  { label: '빅코치 판단', value: m.coach, text: true },
].filter((x) => x.value);
const mo = data.moment;

// 점수·포인트 앞의 +/- 로 색을 정합니다
const sign = (v?: string) => (!v ? '' : /^\s*\+/.test(v) ? 'up' : /^\s*[-−]/.test(v) ? 'down' : '');

// 국별 흐름 한 줄 설명
const BADGE: Record<string, string> = { 화료: '화료', 방총: '방총', 타가화료: '타가 화료', 유국: '유국' };
function roundText(r: any) {
  const who = (s?: string) => withMe(s, me) || '상대';
  if (r.result === '화료') return r.how === '론' ? `론 화료${r.from ? ` · ${who(r.from)} 방총` : ''}` : `${r.how ?? '쯔모'} 화료`;
  if (r.result === '방총') return `${who(r.winner)}에게 방총`;
  if (r.result === '타가화료') {
    const how = r.how ?? '론';
    return `${who(r.winner)} ${how} 화료${how === '론' && r.from ? ` · ${who(r.from)} 방총` : ''}`;
  }
  const kind = r.draw ?? '황패유국';
  return r.tenpai ? `${kind} · 텐파이 ${r.tenpai}` : kind;
}

// 막대가 짧아도 누구의 선택인지 알 수 있게 후보 이름 옆에 붙이는 표시
const pickTag = (pick: string) => (pick === 'both' ? '마작껌의 선택 · Mortal 1순위' : pick === 'ai' ? 'Mortal 1순위' : pick === 'me' ? '마작껌의 선택' : '');
const color = (pick: string) => (pick === 'ai' || pick === 'both' ? 'var(--green)' : pick === 'me' ? 'var(--me)' : 'var(--other)');
---
<div class="review">
  {(data.majsoul || data.mortal) && (
    <div class="links">
      {data.majsoul && <a class="btn btn--light btn--small" href={data.majsoul} target="_blank" rel="noopener">작혼 패보 열기</a>}
      {data.mortal && <a class="btn btn--light btn--small" href={data.mortal} target="_blank" rel="noopener">Mortal 리뷰 원본</a>}
    </div>
  )}

  {(data.finals.length > 0 || metrics.length > 0) && (
    <section class="summary" aria-label="대국 결과">
      {data.finals.length > 0 && (
        <div class="panel box">
          <h2 class="h-small">최종 결과</h2>
          <table class="finals">
            <tbody>
              {data.finals.map((f: any) => (
                <tr class:list={{ me: f.seat === me }}>
                  <td class="mono rank">{f.rank}</td>
                  <td class="who">{withMe(f.seat, me)}</td>
                  <td class="mono num">{f.score}</td>
                  <td class:list={['mono num pt', sign(f.pt)]}>{f.pt ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {metrics.length > 0 && (
        <div class="panel box">
          <h2 class="h-small">Mortal 평가</h2>
          <dl class="metrics">
            {metrics.map((x) => (
              <div class="metric">
                <dt>{x.label}</dt>
                <dd class:list={['metric__v', { mono: !x.text, warn: x.warn, text: x.text }]}>{x.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}
    </section>
  )}

  {data.rounds.length > 0 && (
    <section class="sec" aria-labelledby="flow-title">
      <h2 id="flow-title" class="serif h2">국별 흐름</h2>
      <ol class="rounds">
        {data.rounds.map((r: any) => (
          <li class:list={['round', { key: r.key }]}>
            <span class="round__label">{kyokuLabel(r.kyoku, r.honba)}</span>
            <span class:list={['badge', `badge--${r.result}`]}>{BADGE[r.result]}</span>
            <span class="round__text">
              {roundText(r)}
              {r.note && <span class="round__note">{r.note}</span>}
              {r.key && <span class="round__key">주요 국면</span>}
            </span>
            <span class:list={['mono round__delta', sign(r.delta)]}>{r.delta}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {mo && (
    <section class="sec" aria-labelledby="key-title">
      <h2 id="key-title" class="serif h2">주요 국면</h2>
      <div class="panel moment">
        <div class="moment__head">
          <h3 class="moment__title">{kyokuLabel(mo.kyoku, mo.honba)}{mo.turn && ` ${mo.turn}순`} · {mo.title}</h3>
          {mo.situation && <p class="moment__sit">{mo.situation}</p>}
        </div>
        <MahjongTable moment={mo} myseat={data.myseat} />
        {mo.candidates.length > 0 && (
          <div class="stack">
            <h4 class="h-small">Mortal 판단</h4>
            {mo.candidates.map((c: any) => (
              <div class="cand">
                <span class="cand__name">{c.action}{pickTag(c.pick) && <span class:list={['cand__tag', `cand__tag--${c.pick}`]}>({pickTag(c.pick)})</span>}</span>
                <div class="bar"><div style={`width:${Math.max(0, Math.min(100, c.prob))}%;background:${color(c.pick)}`}></div></div>
                <span class="mono cand__p">{c.prob}%</span>
              </div>
            ))}
            <div class="legend">
              <span><i style="background:var(--green)"></i>Mortal 1순위</span>
              <span><i style="background:var(--me)"></i>마작껌의 선택</span>
              <span><i style="background:var(--other)"></i>그 외</span>
            </div>
          </div>
        )}
        {(mo.why || mo.mortalWhy) && (
          <div class="notes">
            {mo.why && <div class="note note--me"><h4>대국 중 내 판단</h4><p>{mo.why}</p></div>}
            {mo.mortalWhy && <div class="note note--ai"><h4>Mortal의 선택 이유 추정</h4><p>{mo.mortalWhy}</p></div>}
          </div>
        )}
      </div>
    </section>
  )}
</div>

<style>
  .review { display: flex; flex-direction: column; gap: 44px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; }
  .h-small { margin: 0 0 6px; font-size: 14px; font-weight: 700; color: var(--ink-2); }
  .h2 { margin: 0; font-size: clamp(22px, 2.6vw, 26px); letter-spacing: -0.03em; }
  .sec { display: flex; flex-direction: column; gap: 14px; }
  .up { color: var(--green); }
  .down { color: var(--red); }

  /* 최종 결과 + Mortal 평가 */
  .summary { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 14px; }
  .box { padding: 14px 18px; border-radius: var(--r-md); }
  .finals { width: 100%; border-collapse: collapse; font-size: 14px; }
  .finals td { padding: 5px 0; border-bottom: 1px solid var(--line); }
  .finals tr:last-child td { border-bottom: 0; }
  .finals .rank { width: 40px; color: var(--muted); font-size: 13px; }
  .finals .who { padding-right: 8px; }
  .finals .num { text-align: right; white-space: nowrap; font-weight: 600; }
  .finals .pt { width: 72px; font-size: 13px; }
  .finals tr.me td { font-weight: 700; }
  .finals tr.me .who::after { content: ''; display: inline-block; width: 6px; height: 6px; margin-left: 7px; border-radius: 50%; background: var(--point); vertical-align: middle; }
  .metrics { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; }
  .metric { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .metric dt { font-size: 12px; color: var(--muted); }
  .metric__v { margin: 0; font-size: 24px; font-weight: 600; line-height: 1.2; color: var(--ink); letter-spacing: -0.02em; }
  .metric__v.warn { color: var(--red); }
  .metric__v.text { font-size: 18px; font-weight: 700; padding-top: 3px; }

  /* 국별 흐름: 한 국에 한 줄 */
  .rounds { list-style: none; margin: 0; padding: 0; background: var(--card); border-radius: var(--r-md); box-shadow: var(--shadow); overflow: hidden; }
  .round { display: grid; grid-template-columns: 112px 66px minmax(0, 1fr) 76px; align-items: center; gap: 10px; padding: 7px 16px; border-top: 1px solid var(--line); font-size: 14px; }
  .round:first-child { border-top: 0; }
  .round.key { background: var(--green-tint); box-shadow: inset 3px 0 0 var(--felt); }
  .round__label { font-weight: 700; white-space: nowrap; }
  .badge { justify-self: start; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
  .badge--화료 { background: var(--green-tint); color: var(--green); }
  .round.key .badge--화료 { background: #fff; }
  .badge--방총 { background: var(--red-tint); color: var(--red-ink); }
  .badge--타가화료 { background: #d3dce9; color: #1c4a86; }
  .badge--유국 { background: var(--paper-2); color: var(--muted); }
  .round__text { color: var(--ink-2); display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .round__note { font-size: 12px; color: var(--muted); }
  .round__key { font-size: 11px; font-weight: 700; color: var(--felt); }
  .round__delta { text-align: right; font-weight: 600; white-space: nowrap; color: var(--muted); }
  .round__delta.up { color: var(--green); }
  .round__delta.down { color: var(--red); }

  /* 주요 국면 */
  .moment { border-radius: var(--r-lg); padding: clamp(12px, 2.4vw, 22px); display: flex; flex-direction: column; gap: 20px; }
  .moment__head { display: flex; flex-direction: column; gap: 4px; }
  .moment__title { margin: 0; font-family: var(--display); font-size: 19px; letter-spacing: -0.02em; }
  .moment__sit { margin: 0; font-size: 14px; color: var(--muted); }
  .stack { display: flex; flex-direction: column; gap: 10px; }
  .label { font-size: 13px; color: var(--muted); font-weight: 500; }
  .mat .label { color: var(--felt-muted); }
  .cand { display: grid; grid-template-columns: minmax(120px, 260px) minmax(0, 1fr) 58px; align-items: center; gap: 12px; }
  .cand__name { font-weight: 700; font-size: 14px; }
  .cand__tag { margin-left: 6px; font-size: 12px; font-weight: 600; white-space: nowrap; }
  .cand__tag--me { color: #b8601f; }
  .cand__tag--ai, .cand__tag--both { color: var(--green); }
  .bar { height: 10px; background: var(--paper-2); border-radius: 5px; overflow: hidden; }
  .bar div { height: 100%; border-radius: 5px; }
  .cand__p { font-size: 14px; font-weight: 600; text-align: right; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: var(--muted); }
  .legend span { display: flex; align-items: center; gap: 6px; }
  .legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .note { border-radius: var(--r-md); padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; border-left: 4px solid; }
  .note h4 { margin: 0; font-size: 14px; }
  .note p { margin: 0; font-size: 15px; line-height: 1.8; color: var(--ink-2); }
  .note--me { background: var(--red-tint); border-color: var(--me); }
  .note--me h4 { color: var(--red-ink); }
  .note--ai { background: var(--green-tint); border-color: var(--green); }
  .note--ai h4 { color: var(--green); }

  @media (max-width: 720px) {
    .summary { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .round { grid-template-columns: 100px minmax(0, 1fr) 64px; grid-template-areas: 'label badge delta' 'text text text'; row-gap: 4px; padding: 9px 12px; }
    .round__label { grid-area: label; font-size: 13px; }
    .badge { grid-area: badge; }
    .round__text { grid-area: text; font-size: 13px; }
    .round__delta { grid-area: delta; }
    .cand { grid-template-columns: minmax(0, 1fr) 50px; grid-template-areas: 'name p' 'bar bar'; gap: 4px 8px; }
    .cand__name { grid-area: name; }
    .cand .bar { grid-area: bar; }
    .cand__p { grid-area: p; }
  }
</style>
