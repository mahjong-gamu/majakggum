---
import { parseTiles, tileSrc } from '../lib/tiles.mjs';

interface Props {
  tiles?: string;
  draw?: string;
  size?: 'lg' | 'sm' | 'card';
  label?: string;
}
const { tiles = '', draw, size = 'lg', label } = Astro.props;
const list = parseTiles(tiles);
const drawList = draw ? parseTiles(draw) : [];
const names = (l: { name: string }[]) => l.map((t) => t.name).join(' ');
---
<div class={`tiles tiles--${size}`} role="img" aria-label={label ?? `패 ${names(list)}${drawList.length ? `, 쯔모 ${names(drawList)}` : ''}`}>
  {list.map((t) => <img class="tile" src={tileSrc(t)} alt="" width="60" height="80" />)}
  {drawList.length > 0 && <span class="tile-gap" aria-hidden="true"></span>}
  {drawList.map((t) => <img class="tile tile--draw" src={tileSrc(t)} alt="" width="60" height="80" />)}
</div>
