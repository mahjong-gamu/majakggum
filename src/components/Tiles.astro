---
import { parseTiles } from '../lib/tiles.mjs';

interface Props {
  tiles?: string;
  draw?: string;
  size?: 'lg' | 'sm' | 'card';
  label?: string;
}
const { tiles = '', draw, size = 'lg', label } = Astro.props;
const list = parseTiles(tiles);
const drawList = draw ? parseTiles(draw) : [];
---
<div class={`tiles tiles--${size}`} role="img" aria-label={label ?? `패 ${tiles}${draw ? ` 쯔모 ${draw}` : ''}`}>
  {list.map((t) => (
    <span class={`tile tile--${t.tone}`} aria-hidden="true">{t.face}{t.suit && <small>{t.suit}</small>}</span>
  ))}
  {drawList.length > 0 && <span class="tile-gap" aria-hidden="true"></span>}
  {drawList.map((t) => (
    <span class={`tile tile--${t.tone}`} aria-hidden="true">{t.face}{t.suit && <small>{t.suit}</small>}</span>
  ))}
</div>
