---
// 용어 페이지 (시안 B): 왼쪽 큰 칸(이름·짧은 뜻·예시 패) + 「자세히」 / 오른쪽 정보 칸
import { GLOSSARY, SHOW_CHECK_BADGE, glossaryUrl, renderMd, resolveSources, type GlossaryEntry } from '../lib/glossary';

interface Props { entry: GlossaryEntry; entries: GlossaryEntry[]; pending: Map<string, string> }
const { entry: e, entries, pending } = Astro.props;

const detailHtml = await renderMd(e.detail);
const tilesHtml = e.tiles ? await renderMd('`' + e.tiles + '`') : '';
const { site, out } = await resolveSources(e);
const related = e.related.map((id) => {
  const hit = entries.find((x) => x.id === id);
  return hit ? { id, name: hit.term, href: glossaryUrl(id) } : { id, name: pending.get(id) ?? id, href: null };
});
const yakuman = Boolean(e.han && 'yakuman' in e.han);
const han = e.han && !('yakuman' in e.han) ? e.han : null;
const catHref = `${GLOSSARY.path}?c=${encodeURIComponent(e.category)}`;
---
<div class="wrap gt">
  <nav class="gt-crumb muted" aria-label="위치">
    <a href={GLOSSARY.path}>{GLOSSARY.label}</a> › <a href={catHref}>{e.category}</a>
  </nav>

  <div class="gt-cols">
    <article class="gt-main">
      <div class="panel gt-title">
        <h1 class="display">{e.term}{SHOW_CHECK_BADGE && e.check && <span class="gt-check">확인 필요</span>}</h1>
        <p class="gt-short">{e.short}</p>
        {tilesHtml && <div class="gt-tiles" set:html={tilesHtml} />}
      </div>

      <div class="panel gt-detail">
        <h2 class="gt-sec">자세히</h2>
        <p class="gt-hint muted">패 그림 읽는 법: 옆으로 눕힌 패는 남에게서 가져온 패, 뒷면 패는 안깡, 띄어 놓은 묶음은 따로 놓인 패입니다.</p>
        <div class="prose" set:html={detailHtml} />
        <aside class="ai-note" aria-label="작성 도움 안내">
          <span class="ai-note__mark" aria-hidden="true">✦</span>
          <p>이 항목은 <strong>Claude</strong>(Anthropic의 AI)의 도움을 받아 작성했습니다.</p>
        </aside>
      </div>
    </article>

    <aside class="gt-side">
      <div class="panel gt-info">
        <div class="gt-kv"><span class="muted">일본어</span><span>{e.ja}</span></div>
        {e.aka.length > 0 && <div class="gt-kv"><span class="muted">다른 이름</span><span>{e.aka.join(', ')}</span></div>}
        <div class="gt-kv"><span class="muted">분류</span><span><a class="chip" href={catHref} style={`background:${GLOSSARY.tint};color:${GLOSSARY.ink};text-decoration:none`}>{e.category}</a></span></div>

        {e.rule_note && (
          <div class="gt-rule">
            <span class="gt-sec gt-sec--s">룰 비교</span>
            <p>{e.rule_note}</p>
          </div>
        )}
        {(han || yakuman) && (
          <div class="gt-han">
            <span class="gt-sec gt-sec--s">판수</span>
            {yakuman
              ? <div class="gt-han__grid"><div class="gt-han__c gt-han__c--a"><div class="v">역만</div></div></div>
              : <div class="gt-han__grid">
                  <div class="gt-han__c gt-han__c--a"><div class="l">멘젠</div><div class="v">{han!.closed}판</div></div>
                  <div class="gt-han__c"><div class="l">후로</div><div class="v">{han!.open === null ? '불가' : `${han!.open}판`}</div></div>
                </div>}
            <span class="muted gt-han__n">M리그 기준</span>
          </div>
        )}
      </div>

      {related.length > 0 && (
        <div class="panel gt-box">
          <span class="gt-sec gt-sec--s">관련 용어</span>
          <div class="gt-rel">
            {related.map((r) => r.href
              ? <a class="gt-pill" href={r.href}>{r.name}</a>
              : <span class="gt-pill gt-pill--off" title="아직 사전에 없는 용어입니다">{r.name}</span>)}
          </div>
        </div>
      )}

      {(site.length > 0 || out.length > 0) && (
        <div class="panel gt-box">
          {site.length > 0 && (
            <>
              <span class="gt-sec gt-sec--s">나오는 글</span>
              <ul class="gt-list">{site.map((s) => <li><a href={s.href}>{s.title}</a></li>)}</ul>
            </>
          )}
          {out.length > 0 && (
            <>
              <span class="gt-sec gt-sec--s" style={site.length ? 'margin-top:8px' : ''}>출처</span>
              <ul class="gt-list gt-list--src">{out.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.name}</a></li>)}</ul>
            </>
          )}
        </div>
      )}
    </aside>
  </div>
</div>

<style>
  .gt { display: flex; flex-direction: column; gap: 24px; padding-top: 32px; }
  .gt-crumb { font-size: 14px; }
  .gt-cols { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; }
  .gt-main { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .gt-side { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .gt-title { padding: 36px 40px; display: flex; flex-direction: column; gap: 22px; }
  .gt-title h1 { margin: 0; font-size: 44px; font-weight: 800; letter-spacing: -0.04em; line-height: 1.2; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .gt-check { font-size: 13px; font-weight: 700; letter-spacing: 0; padding: 3px 10px; border-radius: 50px; background: var(--red-tint); color: var(--red-ink); }
  .gt-short { margin: 0; font-size: 20px; line-height: 1.7; font-weight: 600; }
  .gt-tiles { background: var(--paper); border-radius: var(--r-sm); padding: 8px 20px; }
  .gt-detail { padding: 32px 40px; }
  .gt-sec { margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; color: var(--muted); }
  .gt-sec--s { display: block; letter-spacing: 0; margin: 0; font-weight: 600; }
  .gt-hint { margin: 0 0 16px; font-size: 14px; }
  .gt-detail .prose { max-width: none; }
  .ai-note { margin-top: 24px; display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 14px; }
  .ai-note p { margin: 0; line-height: 1.6; }
  .ai-note strong { color: var(--ink-2); }
  .ai-note__mark { color: var(--accent); font-size: 13px; }
  .gt-info { padding: 12px 24px 20px; }
  .gt-kv { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .gt-kv .muted { font-size: 13px; font-weight: 600; }
  .gt-rule { padding-top: 14px; }
  .gt-rule p { margin: 6px 0 0; padding: 10px 12px; border-radius: var(--r-sm); background: var(--paper-2); font-size: 14px; line-height: 1.65; color: var(--ink-2); }
  .gt-han { padding-top: 14px; display: flex; flex-direction: column; gap: 6px; }
  .gt-han__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .gt-han__c { background: var(--paper-2); color: var(--ink-2); border-radius: var(--r-sm); padding: 10px 14px; font-weight: 700; }
  .gt-han__c--a { background: var(--mint); color: var(--brand); }
  .gt-han__c .l { font-size: 12px; }
  .gt-han__c .v { font-size: 24px; font-weight: 800; }
  .gt-han__n { font-size: 12px; }
  .gt-box { padding: 20px 24px; display: flex; flex-direction: column; gap: 12px; }
  .gt-rel { display: flex; flex-wrap: wrap; gap: 8px; }
  .gt-pill { display: inline-flex; align-items: center; min-height: 40px; padding: 7px 16px; border-radius: 50px; font-size: 14px; font-weight: 600; border: 1px solid var(--accent); color: var(--accent); text-decoration: none; }
  .gt-pill:hover { background: var(--mint); color: var(--brand); }
  .gt-pill--off { border-color: var(--line); color: var(--muted); cursor: default; }
  .gt-pill--off:hover { background: transparent; color: var(--muted); }
  .gt-list { margin: 0; padding-left: 1.2em; font-size: 14px; line-height: 1.9; }
  .gt-list a { font-weight: 600; }
  .gt-list--src li::marker { color: var(--point); }
  @media (max-width: 640px) {
    .gt { padding-top: 16px; gap: 16px; }
    .gt-cols { gap: 16px; }
    .gt-title { padding: 24px 20px; gap: 16px; }
    .gt-title h1 { font-size: 32px; }
    .gt-short { font-size: 17px; }
    .gt-tiles { padding: 4px 12px; }
    .gt-detail { padding: 24px 20px; }
    .gt-main { flex-basis: 100%; }
  }
</style>
