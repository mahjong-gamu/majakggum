---
// 주요 국면을 마작 테이블처럼 보여줍니다.
// 가운데: 국·본장·공탁·순목·도라 표시패와 네 사람의 자풍·점수
// 네 변: 각자의 버림패(리치 선언패는 옆으로) / 각자 오른쪽 구석: 후로패 / 아래: 내 손패
import { parseTiles, tileSrc } from '../lib/tiles.mjs';
import { kyokuLabel, seatWind, seatsAround, formatScore, MY_NAME, type Seat } from '../lib/mahjong';

interface Props {
  moment: any;
  myseat: Seat;
}
const { moment: mo, myseat } = Astro.props;
const around = seatsAround(myseat);
const POS = [
  { key: 'bottom', rot: 0 },
  { key: 'right', rot: -90 },
  { key: 'top', rot: 180 },
  { key: 'left', rot: 90 },
] as const;

type Cell = { src: string; side?: boolean; back?: boolean };

// 버림패를 6장씩 줄로 나눕니다. riichi 번째 패는 옆으로.
function riverRows(river: string, riichi?: number): Cell[][] {
  const cells = parseTiles(river).map((t, i) => ({ src: tileSrc(t), side: riichi === i + 1 }));
  const rows: Cell[][] = [];
  for (let i = 0; i < cells.length; i += 6) rows.push(cells.slice(i, i + 6));
  return rows;
}

function meldCells(m: any): Cell[] {
  const md = typeof m === 'string' ? { tiles: m } : m;
  const list = parseTiles(md.tiles);
  return list.map((t, i) => ({
    src: tileSrc(t),
    side: md.called === i + 1,
    back: Boolean(md.closed) && (i === 0 || i === list.length - 1),
  }));
}

const seats = POS.map(({ key, rot }) => {
  const seat = around[key] as Seat;
  const p = mo.players?.[seat] ?? {};
  const wind = seatWind(seat, mo.kyoku);
  return {
    key,
    rot,
    seat,
    wind,
    me: seat === myseat,
    score: p.score !== undefined ? formatScore(p.score) : '',
    riichi: Boolean(p.riichi),
    rows: riverRows(p.river ?? '', p.riichi),
    melds: (p.melds ?? []).map(meldCells),
    hand: handCells(seat, p),
    draw: seat === myseat && mo.draw ? parseTiles(mo.draw).map((t) => tileSrc(t)) : [],
  };
});

// 손패: 나는 moment.hand, 상대는 players.자리.hand. 상대 손패를 안 적었으면 뒷면으로 (13 - 후로 수 × 3장)
function handCells(seat: Seat, p: any): string[] {
  const src = seat === myseat ? mo.hand : p.hand;
  if (src) return parseTiles(src).map((t) => tileSrc(t));
  const n = Math.max(0, 13 - 3 * (p.melds?.length ?? 0));
  return Array.from({ length: n }, () => '/tiles/back.svg');
}
const dora = parseTiles(mo.dora ?? '').map((t) => ({ src: tileSrc(t), name: t.name }));
const label = kyokuLabel(mo.kyoku, mo.honba);
const summary = `${label}${mo.turn ? ` ${mo.turn}순` : ''}. ` + seats.map((s) => `${s.seat}${s.me ? `(${MY_NAME})` : ''} ${s.wind} ${s.score}점`).join(', ');
---
<figure class="mt" aria-label={summary}>
  <div class="mt__table felt">
    <div class="board">
      {seats.map((s) => (
        <div class="layer" style={`--rot:${s.rot}deg`}>
          <div class="river">
            {s.rows.map((row) => (
              <div class="row">
                {row.map((c) => (c.side
                  ? <span class="side"><img src={c.src} alt="" width="60" height="78" /></span>
                  : <img class="t" src={c.src} alt="" width="60" height="78" />))}
              </div>
            ))}
          </div>
          <!-- 손패 + 쯔모 + 후로를 한 줄로, 그 변의 가운데에 -->
          <div class:list={['handrow', { opp: !s.me }]}>
            <span class="hand">
              {s.hand.map((src) => <img class="t" src={src} alt="" width="60" height="78" />)}
              {s.draw.length > 0 && <span class="hand__gap"></span>}
              {s.draw.map((src) => <img class="t t--draw" src={src} alt="" width="60" height="78" />)}
            </span>
            {s.melds.map((m: Cell[]) => (
              <span class="meld">
                {m.map((c) => (c.side
                  ? <span class="side"><img src={c.back ? '/tiles/back.svg' : c.src} alt="" width="60" height="78" /></span>
                  : <img class="t" src={c.back ? '/tiles/back.svg' : c.src} alt="" width="60" height="78" />))}
              </span>
            ))}
          </div>
        </div>
      ))}

      <div class="center">
        {seats.map((s) => (
          <div class="clayer" style={`--rot:${s.rot}deg`}>
            <div class:list={['plate', { 'plate--me': s.me }]}>
              {s.riichi && <span class="stick" aria-hidden="true"></span>}
              <span class:list={['plate__wind', { oya: s.wind === '동' }]}>{s.wind}</span>
              <span class="plate__score">{s.score}</span>
              <span class="plate__seat">{s.seat}{s.me && `·${MY_NAME}`}</span>
            </div>
          </div>
        ))}
        <div class="center__mid">
          <span class="center__kyoku">{label}</span>
          <span class="center__sub">공탁 {mo.kyotaku}{mo.turn ? ` · ${mo.turn}순` : ''}</span>
          {dora.length > 0 && (
            <span class="center__dora">
              <span>도라 표시패</span>
              {dora.map((d) => <img src={d.src} alt={`도라 표시패 ${d.name}`} width="60" height="78" />)}
            </span>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- 좁은 화면에서는 가운데 글씨가 작아지므로 점수표를 한 번 더 보여줍니다 -->
  <ul class="legend-scores">
    {seats.map((s) => (
      <li class:list={{ me: s.me }}>
        <span class:list={['w', { oya: s.wind === '동' }]}>{s.wind}</span>
        <span>{s.seat}{s.me && `(${MY_NAME})`}</span>
        <span class="digits">{s.score}</span>
        {s.riichi && <span class="r">리치</span>}
      </li>
    ))}
  </ul>
</figure>

<style>
  .mt { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .mt__table { container-type: inline-size; position: relative; width: 100%; max-width: 760px; margin: 0 auto; aspect-ratio: 1; border-radius: var(--r-lg); }
  /* t = 패 1장 너비. 테이블 한 변 = 19.5t. s = 그 줄에서 쓰는 패 크기 */
  .board { position: absolute; inset: 0; --t: calc(100cqw / 19.5); --s: var(--t); }
  .layer { position: absolute; inset: 0; transform: rotate(var(--rot)); }
  .t { display: block; flex: none; width: var(--s); height: calc(var(--s) * 1.3); filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.35)); }
  .side { position: relative; display: block; flex: none; width: calc(var(--s) * 1.3); height: var(--s); }
  .side img { position: absolute; left: 50%; top: 50%; width: var(--s); height: calc(var(--s) * 1.3); transform: translate(-50%, -50%) rotate(-90deg); filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.35)); }

  .river { position: absolute; top: calc(50% + var(--t) * 3.3); left: calc(50% - var(--t) * 3); display: flex; flex-direction: column; }
  .row { display: flex; align-items: flex-end; }
  /* 손패·후로 줄: 각 변의 가운데 */
  .handrow { position: absolute; left: 0; right: 0; bottom: calc(var(--t) * 0.2); display: flex; justify-content: center; align-items: flex-end; gap: calc(var(--s) * 0.3); }
  .handrow.opp { --s: calc(var(--t) * 0.82); }
  .hand, .meld { display: flex; align-items: flex-end; }
  .hand__gap { width: calc(var(--s) * 0.3); }
  .t--draw { transform: translateY(calc(var(--s) * -0.15)); }

  .center { position: absolute; left: 50%; top: 50%; width: calc(var(--t) * 6.2); height: calc(var(--t) * 6.2); transform: translate(-50%, -50%); background: #101a16; border-radius: calc(var(--t) * 0.45); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 6px 18px rgba(0, 0, 0, 0.35); color: #f3efe4; }
  .clayer { position: absolute; inset: 0; transform: rotate(var(--rot)); }
  .plate { position: absolute; left: 0; right: 0; bottom: calc(var(--t) * 0.18); display: flex; align-items: baseline; justify-content: center; gap: calc(var(--t) * 0.18); line-height: 1; }
  .plate__wind { font-family: var(--display); font-weight: 800; font-size: max(10px, calc(var(--t) * 0.5)); }
  .plate__wind.oya { color: #ff6b5e; }
  .plate__score { font-variant-numeric: tabular-nums; font-weight: 600; font-size: max(10px, calc(var(--t) * 0.46)); }
  .plate__seat { font-size: max(8px, calc(var(--t) * 0.3)); color: var(--felt-muted); }
  .plate--me .plate__score { color: var(--mint); }
  .stick { position: absolute; left: 50%; bottom: calc(var(--t) * 0.72); width: calc(var(--t) * 2.4); height: calc(var(--t) * 0.16); transform: translateX(-50%); border-radius: 99px; background: #fff; }
  .stick::after { content: ''; position: absolute; left: 50%; top: 50%; width: calc(var(--t) * 0.12); height: calc(var(--t) * 0.12); border-radius: 50%; background: #d4201b; transform: translate(-50%, -50%); }
  .center__mid { position: absolute; inset: calc(var(--t) * 1.05); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: calc(var(--t) * 0.16); text-align: center; }
  .center__kyoku { font-family: var(--display); font-weight: 800; font-size: max(12px, calc(var(--t) * 0.58)); white-space: nowrap; letter-spacing: -0.02em; }
  .center__sub { font-size: max(9px, calc(var(--t) * 0.32)); color: var(--felt-muted); white-space: nowrap; }
  .center__dora { display: flex; align-items: center; gap: calc(var(--t) * 0.08); font-size: max(9px, calc(var(--t) * 0.3)); color: var(--felt-muted); }
  .center__dora span { margin-right: calc(var(--t) * 0.08); }
  .center__dora img { width: calc(var(--t) * 0.62); height: auto; }

  .legend-scores { display: none; list-style: none; margin: 0; padding: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
  .legend-scores li { display: flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: var(--r-sm); background: var(--paper); font-size: 13px; }
  .legend-scores li.me { background: var(--green-tint); font-weight: 700; }
  .legend-scores .w { font-family: var(--display); font-weight: 800; }
  .legend-scores .w.oya { color: var(--red); }
  .legend-scores .digits { margin-left: auto; font-weight: 600; }
  .legend-scores .r { font-size: 11px; font-weight: 700; color: var(--red); }
  @media (max-width: 560px) {
    .legend-scores { display: grid; }
    .mt__table { border-radius: var(--r-lg); }
  }
  /* 테이블이 작으면 가운데에는 자풍·국만 두고, 점수는 아래 점수표로 */
  @container (max-width: 520px) {
    .plate__score, .plate__seat, .center__sub { display: none; }
    .plate__wind { font-size: calc(var(--t) * 0.62); }
    .center__kyoku { font-size: calc(var(--t) * 0.6); }
    .center__dora { font-size: calc(var(--t) * 0.4); }
  }
</style>
