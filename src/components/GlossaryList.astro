---
// 용어 사전 목록 (시안 A): 머리 칸 → 찾기 칸 → 분류 단추 → 초성 바로가기 → 초성별 흰 칸
import { CATEGORIES, GLOSSARY, INITIALS, glossaryUrl, initialOf, type GlossaryEntry } from '../lib/glossary';

interface Props { entries: GlossaryEntry[] }
const { entries } = Astro.props;

const counts = new Map(CATEGORIES.map((c) => [c, entries.filter((e) => e.category === c).length]));
const groups = INITIALS.map((ini) => ({ ini, items: entries.filter((e) => initialOf(e.term) === ini) }));
const keyOf = (e: GlossaryEntry) => [e.term, e.ja, ...e.aka].join(' ').toLowerCase();
---
<div class="wrap gl">
  <section class="gl-hero" style={`background:${GLOSSARY.tint};color:${GLOSSARY.ink}`}>
    <div class="gl-hero__text">
      <span class="gl-hero__eyebrow digits">용어 {entries.length}개 · {GLOSSARY.batch}</span>
      <h1 class="display">{GLOSSARY.label}</h1>
      <p>{GLOSSARY.intro}</p>
    </div>
    <img class="gl-hero__tile" src={`/tiles/${GLOSSARY.wind}.svg`} alt="" width="60" height="78" />
  </section>

  <div class="gl-tools">
    <label class="gl-search">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
      <span class="sr">용어 찾기</span>
      <input type="search" id="gl-q" placeholder="용어·일본어·다른 이름으로 찾기 (예: 우라도라, 辺張, 펜짱)" autocomplete="off" />
    </label>
    <div class="gl-cats" role="group" aria-label="분류">
      <button class="pill is-on" type="button" data-cat="">전체<span class="n digits">{entries.length}</span></button>
      {CATEGORIES.map((c) => counts.get(c)
        ? <button class="pill" type="button" data-cat={c}>{c}<span class="n digits">{counts.get(c)}</span></button>
        : <button class="pill pill--soon" type="button" disabled>{c}<span class="n">곧</span></button>)}
    </div>
  </div>

  <nav class="gl-ini" aria-label="초성으로 이동">
    {groups.map(({ ini, items }) => items.length
      ? <a href={`#cho-${ini}`} class="has" data-ini={ini}>{ini}</a>
      : <span class="none" aria-hidden="true">{ini}</span>)}
  </nav>

  <p class="gl-none muted" data-none hidden>찾는 용어가 없어요. 다른 낱말로 찾아보세요.</p>

  {groups.filter((g) => g.items.length).map(({ ini, items }) => (
    <section class="panel gl-group" id={`cho-${ini}`} data-group={ini}>
      <div class="gl-group__head"><h2>{ini}</h2><span class="muted digits" data-count>{items.length}개</span></div>
      {items.map((e) => (
        <a class="gl-row" href={glossaryUrl(e.id)} data-cat={e.category} data-key={keyOf(e)}>
          <strong>{e.term}</strong>
          <span class="gl-row__cat muted">{e.category}</span>
          <span class="gl-row__short muted">{e.short}</span>
          <span class="gl-row__go" aria-hidden="true">›</span>
        </a>
      ))}
    </section>
  ))}
</div>

<script is:inline>
  (function () {
    var q = document.getElementById('gl-q');
    var pills = [].slice.call(document.querySelectorAll('.gl-cats [data-cat]:not([disabled])'));
    var rows = [].slice.call(document.querySelectorAll('.gl-row'));
    var groups = [].slice.call(document.querySelectorAll('.gl-group'));
    var none = document.querySelector('[data-none]');
    var cat = '';
    function apply() {
      var w = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      var shown = 0;
      rows.forEach(function (r) {
        var ok = (!cat || r.dataset.cat === cat) && w.every(function (x) { return r.dataset.key.indexOf(x) >= 0; });
        r.hidden = !ok;
        if (ok) shown++;
      });
      groups.forEach(function (g) {
        var n = g.querySelectorAll('.gl-row:not([hidden])').length;
        g.hidden = n === 0;
        g.querySelector('[data-count]').textContent = n + '개';
        var a = document.querySelector('.gl-ini [data-ini="' + g.dataset.group + '"]');
        if (a) a.classList.toggle('dim', n === 0);
      });
      none.hidden = shown !== 0;
      pills.forEach(function (p) { p.classList.toggle('is-on', p.dataset.cat === cat); });
    }
    pills.forEach(function (p) { p.addEventListener('click', function () { cat = p.dataset.cat; apply(); }); });
    q.addEventListener('input', apply);
    var c = new URLSearchParams(location.search).get('c');
    if (c && pills.some(function (p) { return p.dataset.cat === c; })) cat = c;
    apply();
  })();
</script>

<style>
  .gl { display: flex; flex-direction: column; gap: 28px; padding-top: 32px; }
  .sr { position: absolute; left: -9999px; }
  .gl-hero { border-radius: var(--r-lg); padding: 48px 56px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .gl-hero__text { display: flex; flex-direction: column; gap: 12px; }
  .gl-hero__eyebrow { font-size: 13px; font-weight: 600; }
  .gl-hero h1 { margin: 0; font-size: 52px; letter-spacing: -0.04em; line-height: 1.18; font-weight: 800; }
  .gl-hero p { margin: 0; font-size: 17px; line-height: 1.75; color: var(--ink-2); max-width: 600px; }
  .gl-hero__tile { flex: none; width: 76px; filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.18)); transform: rotate(-6deg); }
  .gl-tools { display: flex; flex-direction: column; gap: 16px; }
  .gl-search { position: relative; display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--line-2); border-radius: 50px; padding: 0 20px; min-height: 52px; }
  .gl-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--mint); }
  .gl-search input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 16px; background: transparent; color: var(--ink); }
  .gl-search svg { width: 20px; height: 20px; flex: none; color: var(--muted); }
  .gl-cats { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 7px 16px; border-radius: 50px; font-size: 14px; font-weight: 600; border: 1px solid var(--line-2); background: var(--card); color: var(--ink-2); cursor: pointer; transition: transform 0.15s ease; }
  .pill:active:not(:disabled) { transform: scale(0.95); }
  .pill.is-on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pill--soon { background: transparent; border-style: dashed; color: var(--muted); cursor: default; }
  .pill .n { font-size: 12px; font-weight: 700; opacity: 0.75; }
  .gl-ini { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; padding: 8px 0; }
  .gl-ini a, .gl-ini span { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; border-radius: 50px; text-decoration: none; font-weight: 700; font-size: 15px; }
  .gl-ini a.has { background: var(--card); color: var(--brand); box-shadow: var(--shadow); }
  .gl-ini a.dim { background: transparent; color: var(--muted); box-shadow: none; pointer-events: none; }
  .gl-ini .none { color: var(--muted); }
  .gl-none { margin: 0; text-align: center; padding: 24px 0; }
  .gl-group { overflow: hidden; padding: 0; scroll-margin-top: 88px; }
  .gl-group[hidden], .gl-row[hidden], .gl-none[hidden] { display: none; }
  .gl-group__head { display: flex; align-items: baseline; gap: 12px; padding: 18px 24px 14px; }
  .gl-group__head h2 { margin: 0; font-size: 26px; font-weight: 800; color: var(--point); }
  .gl-group__head span { font-size: 13px; }
  .gl-row { display: grid; grid-template-columns: 220px 92px minmax(0, 1fr) 20px; gap: 16px; align-items: center; padding: 14px 24px; border-top: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: background 0.15s ease; }
  .gl-row:hover { background: var(--paper); color: var(--ink); }
  .gl-row strong { font-size: 17px; font-weight: 700; letter-spacing: -0.02em; }
  .gl-row__cat { font-size: 13px; }
  .gl-row__short { font-size: 15px; line-height: 1.6; }
  .gl-row__go { color: var(--line-2); font-size: 18px; }
  @media (max-width: 860px) {
    .gl-hero { padding: 32px 28px; }
    .gl-hero h1 { font-size: 40px; }
  }
  @media (max-width: 640px) {
    .gl { gap: 14px; padding-top: 16px; }
    .gl-hero { padding: 20px; }
    .gl-hero__text { gap: 6px; }
    .gl-hero h1 { font-size: 30px; }
    .gl-hero p { display: none; }
    .gl-hero__tile { width: 44px; }
    .gl-search { min-height: 48px; }
    .gl-cats { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px; }
    .gl-cats::-webkit-scrollbar { display: none; }
    .pill { flex: none; }
    .gl-ini a, .gl-ini span { min-width: 36px; height: 36px; }
    .gl-group__head { padding: 14px 16px 10px; }
    .gl-row { grid-template-columns: minmax(0, 1fr) 16px; gap: 2px 8px; padding: 12px 16px; }
    .gl-row strong { grid-column: 1; font-size: 16px; }
    .gl-row__cat { display: none; }
    .gl-row__short { grid-column: 1; font-size: 14px; line-height: 1.5; }
    .gl-row__go { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  }
</style>
