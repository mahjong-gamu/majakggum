---
import '../styles/global.css';
import Tiles from '../components/Tiles.astro';
import { BOARDS } from '../lib/boards';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const SITE_NAME = '마작치는 마작껌';
const CONTACT_EMAIL = 'mahjong.iris@gmail.com';
const YOUTUBE_URL = 'https://www.youtube.com/channel/UCYtiv8O8jPptxft8HTMy42A';
const INSTAGRAM_URL = 'https://www.instagram.com/mahjong.gamu/';
// Cloudflare Web Analytics 사이트 토큰. 비어 있으면 방문 분석 코드를 넣지 않습니다.
// (쿠키를 쓰지 않는 집계 방식이고, 토큰은 공개돼도 되는 사이트 구분값입니다)
const ANALYTICS_TOKEN = 'ab5317686b924745acbbe7e864f6c131';
const { title, description = '작혼 패보를 Mortal과 함께 다시 보는 마작 블로그. 패보 복기, 이론 공부, 마장 탐방, 마작 뉴스.', current } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f5f1e8" />
    <link rel="icon" href="/tiles/7z.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@600;700;800&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />
    {ANALYTICS_TOKEN && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/" aria-label={`${SITE_NAME} 홈`}>
          <img src="/tiles/7z.svg" alt="" width="60" height="78" />
          <span class="logo-name">{SITE_NAME}</span>
        </a>
        <nav class="nav" aria-label="게시판">
          {BOARDS.map((b) => (
            <a href={`/${b.key}/`} aria-current={current === b.key ? 'page' : undefined}>{b.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-brand">
          <Tiles tiles="1234z" size="card" label="동 남 서 북" />
          <span class="display">{SITE_NAME}</span>
        </div>
        <span>작혼 패보 · Mortal 복기 · 이론 · 마장 탐방 · 뉴스</span>
        <nav class="footer-social" aria-label="마작껌 SNS">
          <a class="social social--youtube" href={YOUTUBE_URL} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor" /><path d="M10 9l5 3-5 3z" fill="#fff" /></svg>
            유튜브
          </a>
          <a class="social social--instagram" href={INSTAGRAM_URL} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
            인스타그램
          </a>
        </nav>
        <div class="footer-bottom">
          <small>© {new Date().getFullYear()} {SITE_NAME}. All rights reserved.</small>
          <span>문의 <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
        </div>
      </div>
    </footer>
  </body>
</html>
