---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { BOARDS, getBoard, type BoardKey } from '../../lib/boards';
import { getBoardPosts } from '../../lib/posts';

export function getStaticPaths() {
  return BOARDS.map((b) => ({ params: { board: b.key } }));
}

const key = Astro.params.board as BoardKey;
const board = getBoard(key);
const posts = await getBoardPosts(key);
---
<Base title={board.label} description={board.desc} current={key}>
  <div class="wrap list">
    <section class="hero" style={`background:${board.tint}`}>
      <div class="hero__text">
        <span class="mono count" style={`color:${board.ink}`}>글 {posts.length}개</span>
        <h1 class="display" style={`color:${board.ink}`}>{board.label}</h1>
        <p>{board.desc}</p>
      </div>
      <img class="hero__wind" src={`/tiles/${board.wind}.svg`} alt="" width="60" height="78" />
    </section>
    {posts.length > 0 ? (
      <div class="grid">
        {posts.map(({ entry }) => <PostCard board={key} entry={entry} showBoard={false} />)}
      </div>
    ) : (
      <p class="muted">아직 글이 없습니다.</p>
    )}
  </div>
</Base>

<style>
  .list { display: flex; flex-direction: column; gap: 40px; padding-top: 32px; }
  .hero { position: relative; overflow: hidden; border-radius: 28px; padding: clamp(28px, 5vw, 56px); display: flex; align-items: center; justify-content: space-between; gap: 24px; border: 1px solid rgba(0, 0, 0, 0.04); }
  .hero__text { display: flex; flex-direction: column; gap: 12px; }
  .count { font-size: 13px; font-weight: 600; }
  h1 { margin: 0; font-size: clamp(34px, 5vw, 58px); letter-spacing: -0.04em; line-height: 1.15; font-weight: 800; }
  p { margin: 0; font-size: 17px; line-height: 1.75; color: var(--ink-2); max-width: 600px; }
  .hero__wind { flex: none; width: clamp(64px, 9vw, 104px); transform: rotate(-7deg); filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.18)); margin-right: clamp(0px, 3vw, 32px); }
  @media (max-width: 640px) {
    .list { padding-top: 16px; gap: 28px; }
    .hero { border-radius: 22px; align-items: flex-start; }
    .hero__wind { width: 52px; margin: 0; }
    p { font-size: 16px; }
  }
</style>
