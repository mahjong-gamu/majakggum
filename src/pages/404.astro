---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없어요">
  <div class="wrap" style="padding-top:96px;display:flex;flex-direction:column;align-items:center;gap:20px;text-align:center">
    <h1 class="serif" style="margin:0;font-size:40px">유국입니다</h1>
    <p class="muted" style="margin:0">찾으시는 페이지가 없어요. 주소를 다시 확인해 주세요.</p>
    <a class="btn btn--dark" href="/">홈으로</a>
  </div>
</Base>
