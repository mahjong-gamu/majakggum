---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Tiles from '../components/Tiles.astro';
import { BOARDS } from '../lib/boards';
import { getAllPosts, getBoardPosts, postUrl } from '../lib/posts';

const all = await getAllPosts();
const latest = all.slice(0, 6);
const counts = Object.fromEntries(await Promise.all(BOARDS.map(async (b) => [b.key, (await getBoardPosts(b.key)).length])));

// 배너 카드에는 가장 최근 패보 복기 글의 첫 번째 주요 국면을 보여줍니다.
const reviews = await getBoardPosts('reviews');
const featured = reviews[0]?.entry;
const moment = featured?.data.moments?.[0];
const aiPick = moment?.candidates.find((c: any) => c.pick === 'ai' || c.pick === 'both');
const myPick = moment?.candidates.find((c: any) => c.pick === 'me' || c.pick === 'both');
---
<Base>
  <div class="wrap home">
    <section class="banner" aria-labelledby="banner-title">
      <span class="pill">작혼 패보 × Mortal 복기 블로그</span>
      <h1 id="banner-title" class="serif">한 판 치고, 한 번 더<br />생각해보는 마작</h1>
      <p class="lead">
        마작치는 마작껌은 제가 친 작혼 대국을 Mortal과 함께 다시 보는 곳입니다. 주요 국면에서 왜 그렇게 쳤는지, AI는 무엇을 골랐는지 기록하고,
        공부한 이론과 다녀온 마장, 마작 소식도 함께 올립니다.
      </p>
      <div class="actions">
        <a class="btn btn--dark" href="/reviews/">최근 복기 보기</a>
        <a class="btn btn--light" href="/theory/">이론 공부 둘러보기</a>
      </div>

      <div class="banner-cards">
        {featured && moment ? (
          <a class="panel feature" href={postUrl('reviews', featured.id)}>
            <div class="feature__head">
              <span class="avatar mono" aria-hidden="true">AI</span>
              <div>
                <strong>Mortal이 {moment.label.split('·')[0].trim()}을 다시 봤어요</strong>
                <span class="muted small">{featured.data.meta}</span>
              </div>
            </div>
            <Tiles tiles={moment.hand} draw={moment.draw} size="sm" />
            <div class="pick-grid">
              {myPick && (
                <div class="pick pick--me">
                  <span class="pick__who">내 선택</span>
                  <span class="pick__what">{myPick.action}</span>
                  <span class="mono muted small">{myPick.prob}%</span>
                </div>
              )}
              {aiPick && (
                <div class="pick pick--ai">
                  <span class="pick__who">Mortal 추천</span>
                  <span class="pick__what">{aiPick.action}</span>
                  <span class="mono muted small">{aiPick.prob}%</span>
                </div>
              )}
            </div>
          </a>
        ) : null}

        <div class="panel record">
          <strong>복기에서 남기는 것</strong>
          <div class="record__row">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F6B4F" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg>
            <div><strong>대국 중 내 판단</strong><span class="muted">그 순간 무엇을 보고, 왜 그 패를 골랐는지</span></div>
          </div>
          <div class="record__row">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2F5BA8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="12" width="4" height="8" rx="1"></rect><rect x="10" y="7" width="4" height="13" rx="1"></rect><rect x="17" y="3" width="4" height="17" rx="1"></rect></svg>
            <div><strong>Mortal의 판단</strong><span class="muted">후보별 확률과 내 선택과의 차이</span></div>
          </div>
          <div class="record__row">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9C4A17" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-4-4L4 16v4z"></path></svg>
            <div><strong>복기 후 생각</strong><span class="muted">다음 대국에서 의식할 한 가지</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="boards-title">
      <h2 id="boards-title" class="section-title">게시판</h2>
      <div class="boards">
        {BOARDS.map((b) => (
          <a class="board-tile" href={`/${b.key}/`} style={`background:${b.tint}`}>
            <span class="board-tile__name" style={`color:${b.ink}`}>{b.label}</span>
            <span class="board-tile__short">{b.short}</span>
            <span class="board-tile__count mono">글 {counts[b.key]}개 →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="latest-title">
      <h2 id="latest-title" class="section-title">최신 글</h2>
      {latest.length > 0 ? (
        <div class="grid">
          {latest.map(({ board, entry }) => <PostCard board={board} entry={entry} />)}
        </div>
      ) : (
        <p class="muted">아직 글이 없습니다.</p>
      )}
    </section>
  </div>
</Base>

<style>
  .home { display: flex; flex-direction: column; gap: 80px; }
  .banner { padding-top: 72px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; }
  .pill { font-size: 14px; font-weight: 500; padding: 8px 16px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); color: var(--muted); }
  h1 { margin: 0; font-size: clamp(36px, 6.4vw, 76px); line-height: 1.18; letter-spacing: -0.03em; max-width: 920px; }
  .lead { margin: 0; font-size: 18px; line-height: 1.75; color: var(--muted); max-width: 640px; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .banner-cards { width: 100%; max-width: 980px; margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 20px; text-align: left; }
  .banner-cards .panel { border-radius: 28px; padding: 28px; display: flex; flex-direction: column; gap: 18px; }
  .feature { text-decoration: none; color: var(--ink); }
  .feature:hover { color: var(--ink); border-color: var(--line-2); }
  .feature__head { display: flex; align-items: center; gap: 12px; }
  .feature__head div { display: flex; flex-direction: column; gap: 2px; }
  .avatar { width: 40px; height: 40px; flex: none; border-radius: 50%; background: var(--green); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px; }
  .small { font-size: 13px; }
  .pick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .pick { border-radius: 16px; padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; }
  .pick--me { background: var(--red-tint); }
  .pick--ai { background: #e3efe8; }
  .pick__who { font-size: 13px; font-weight: 700; }
  .pick--me .pick__who { color: var(--red-ink); }
  .pick--ai .pick__who { color: var(--green); }
  .pick__what { font-size: 17px; font-weight: 700; }
  .record { gap: 16px !important; }
  .record__row { display: flex; gap: 12px; align-items: flex-start; }
  .record__row svg { flex: none; margin-top: 2px; }
  .record__row div { display: flex; flex-direction: column; gap: 4px; font-size: 15px; }
  .record__row .muted { font-size: 14px; line-height: 1.65; }
  .block { display: flex; flex-direction: column; gap: 20px; }
  .boards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 14px; }
  .board-tile { border-radius: 24px; padding: 22px 24px; display: flex; flex-direction: column; gap: 8px; min-height: 140px; text-decoration: none; color: var(--ink); transition: transform 0.15s ease; }
  .board-tile:hover { color: var(--ink); transform: translateY(-2px); }
  .board-tile__name { font-size: 19px; font-weight: 700; }
  .board-tile__short { font-size: 14px; line-height: 1.6; color: var(--ink-2); }
  .board-tile__count { margin-top: auto; font-size: 13px; color: var(--ink-2); }
  @media (max-width: 640px) {
    .home { gap: 56px; }
    .banner { padding-top: 44px; }
    .lead { font-size: 16px; }
    .banner-cards { margin-top: 12px; }
    .banner-cards .panel { padding: 22px; }
  }
</style>
